        "ALBEF",
        "TCL",
        "CLIP_ViT",
        "CLIP_CNN",
        "--source_model",
        "ALBEF",
        "--albef_ckpt",
        "./checkpoints/albef_coco.pth",
        "--tcl_ckpt",
        "./checkpoints/tcl_coco.pth",
        "--original_rank_index_path",
        "./std_eval_idx/coco/"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}